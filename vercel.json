{
  "redirects": [
    {
      "source": "/((?!reserve|assets/|[^/]+\\.\\w+$).*)",
      "has": [{ "type": "host", "value": "(www\\.)?daweezpensionhouse\\.online" }],
      "destination": "/reserve",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "(www\\.)?daweezpensionhouse\\.online" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ical/room/:room_number/:channel.ics",
      "destination": "https://ctbqxcxqfsrbgzfcmntw.supabase.co/functions/v1/export-ical?room_number=:room_number&for=:channel"
    },
    {
      "source": "/api/ical/room/:room_number.ics",
      "destination": "https://ctbqxcxqfsrbgzfcmntw.supabase.co/functions/v1/export-ical?room_number=:room_number"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
